{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "jsx": "react-jsx",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "noUnusedLocals": false,
    "types": [
      "node",
      "vitest/globals",
      "vitest-fetch-mock"
    ]
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../src/**/*.ts"
  ]
}
