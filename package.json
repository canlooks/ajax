{
  "name": "@canlooks/ajax",
  "version": "5.0.6",
  "description": "A modular request management tool",
  "author": "C.CanLiang <canlooks@gmail.com>",
  "license": "MIT",
  "keywords": [
    "ajax",
    "fetch",
    "modularization"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/canlooks/ajax"
  },
  "homepage": "https://github.com/canlooks/ajax",
  "bugs": {
    "url": "https://github.com/canlooks/ajax/issues",
    "email": "canlooks@gmail.com"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:types": "tsc -p tsconfig.types.json",
    "build:markers": "node scripts/write-module-markers.mjs",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:types && npm run build:markers",
    "test": "vitest run -c test/vitest.config.ts",
    "test:coverage": "vitest run -c test/vitest.config.ts --coverage",
    "test:typecheck": "tsc -p test/tsconfig.json",
    "test:ci": "npm run test:typecheck && npm run test:coverage",
    "test:integration": "vitest run -c test/vitest.integration.config.ts",
    "test:package": "node test/package-consumers.mjs",
    "test:release": "npm run build && npm run test:ci && npm run test:integration && npm run test:package",
    "test:node": "npx ts-node test/node.ts",
    "test:browser": "vite -c test/vite.config.mts",
    "test:watch": "vitest -c test/vitest.config.ts"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6",
    "vitest-fetch-mock": "^0.4.5"
  }
}
